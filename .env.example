# REST API base URL, notifications WS URL, and visual theme are configured in the app
# Settings page (browser localStorage) — not from these env vars.

# Optional fallback only used when seeding the first default server entry:
# VITE_NOTIFICATIONS_WS_URL=http://localhost:3108

# Optional: Vite /api proxy target for legacy same-origin tooling only.
# VITE_API_GATEWAY_URL=http://localhost:8080
