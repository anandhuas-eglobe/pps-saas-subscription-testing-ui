# REST API — Vite dev server (port 3000) proxies /api here.
# Live dev:  https://saasppsgateway.eglobeitsolutions.org
# Local:     http://localhost:8080
VITE_API_GATEWAY_URL=https://saasppsgateway.eglobeitsolutions.org

# Socket.io — must point at the notifications service directly (gateway does not proxy WebSockets).
# Local Docker: http://localhost:3108
# Live dev:     set to your exposed notifications service URL (not the gateway URL)
VITE_NOTIFICATIONS_WS_URL=http://localhost:3108
