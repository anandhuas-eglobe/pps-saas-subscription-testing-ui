# Leave empty to use Vite dev proxy (/api -> http://localhost:3112)
VITE_API_BASE_URL=

# Leave empty to use Vite dev proxy (/api/v1/auth -> http://localhost:3104)
# Set only if calling IAM directly (e.g. http://localhost:3104)
VITE_IAM_BASE_URL=

# Leave empty to use Vite dev proxy (/api/v1/cards -> http://localhost:3107)
# Set only if calling the payment service directly (e.g. http://localhost:3107)
VITE_PAYMENT_BASE_URL=

# Leave empty to use Vite dev proxy (/api/v1/notifications and /socket.io -> http://localhost:3108)
# Set only if calling the notifications service directly (e.g. http://localhost:3108)
VITE_NOTIFICATIONS_BASE_URL=
VITE_NOTIFICATIONS_WS_URL=
